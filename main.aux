\@writefile{toc}{\contentsline {subsection}{\numberline {2.3}Meshing}{3}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Partitioning guideline in order to create a structured mesh for the plate with circular hole. The whole mesh variations use CPS4, which is a 4-node bilinear plane stress quadrilateral element, also using quad-structured mesh control feature for the whole region to retain structured mesh and avoid extreme-distorted element.}}{4}{}\protected@file@percent }
\newlabel{fig:MeshPartitioning}{{2}{4}{Meshing}{figure.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Mesh size variations used for mesh sensitivity analysis.}}{4}{}\protected@file@percent }
\newlabel{tab:mesh-sizes}{{4}{4}{Meshing}{table.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Contour plots of the $S_{22}$ stress component for Mesh 1, 2, 3, and 4 (from left to right, top to bottom). Maximum and minimum stress locations are indicated.}}{6}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Contour plots of the $S_{22}$ stress component for Mesh 5, 6, 7, and 8 (from left to right, top to bottom). Maximum and minimum stress locations are indicated.}}{7}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Stress distribution along the defined path for all mesh sizes. Each curve represents the relevant stress component for a specific mesh configuration, illustrating the effect of mesh refinement on capturing the stress concentration near the circular hole.}}{8}{}\protected@file@percent }
\newlabel{fig:CombinedStressDistribution}{{5}{8}{}{figure.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Stress concentration factor $K_t$ along the defined path for all mesh sizes. Each curve represents the $K_t$ value for a specific mesh configuration, illustrating the effect of mesh refinement on capturing the stress concentration near the circular hole.}}{9}{}\protected@file@percent }
\newlabel{fig:CombinedStressDistribution}{{6}{9}{}{figure.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces (Left) Mesh of the proposed half-symmetry model. (Right) Contour plot of the relevant stress distribution for the half model. The simplified model reduces computational cost while maintaining accuracy due to symmetry.}}{10}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Stress-strain hysteresis loop for the isotropic hardening model under cyclic tension-compression loading. The plot illustrates the expansion of the yield surface and the corresponding material response.}}{11}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Stress-strain hysteresis loop for the kinematic hardening model under cyclic tension-compression loading. The plot demonstrates the translation of the yield surface and the corresponding material response.}}{12}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Stress-strain hysteresis loop for the combined hardening model under cyclic tension-compression loading. The plot shows the material response when both isotropic and kinematic hardening mechanisms are active, illustrating the combined effects on the expansion and translation of the yield surface.}}{13}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Comparison of stress-strain hysteresis loops for isotropic, kinematic, and combined hardening models under cyclic tension-compression loading. The plot highlights the differences in material response due to the various hardening mechanisms.}}{14}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Code section in the UMAT where the plane strain or plane stress condition is selected. This determines the appropriate constitutive behavior for the simulation.}}{14}{}\protected@file@percent }
\newlabel{fig:Q3-PlaneStrain}{{12}{14}{}{figure.12}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces Code lines in the UMAT where the elastic stiffness matrix is calculated. This matrix defines the linear elastic response of the material.}}{15}{}\protected@file@percent }
\newlabel{fig:Q3-ElasticStiffness}{{13}{15}{}{figure.13}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces Code section in the UMAT where the equivalent von Mises stress is computed. This value is used to evaluate yielding according to the J2 plasticity criterion.}}{15}{}\protected@file@percent }
\newlabel{fig:Q3-VonMises}{{14}{15}{}{figure.14}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {15}{\ignorespaces Zoomed-in view of the true stress-strain curve from the tensile simulation, highlighting the detailed behavior near the area of necking and plastic deformation.}}{16}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {16}{\ignorespaces Contour plots of von Mises stress at four representative time frames from the embedded J2 simulation, showing the evolution from elastic to localized necking. The von Mises stress grows starting from the initial loading phase in time frame 1, where it is at the elastic region. At frame 2, it starts to deform plastically as the stress distribution starts to yield.}}{17}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {17}{\ignorespaces Contour plots of equivalent plastic strain at four representative time frames from the embedded J2 simulation, illustrating the progression of plastic deformation and localization.}}{18}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {18}{\ignorespaces SDV1: Distribution of the first state-dependent variable (SDV1) at the final simulation time, representing the relevant stress or plastic strain component. Maximum and minimum locations are indicated.}}{19}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {19}{\ignorespaces SDV2: Distribution of the second state-dependent variable (SDV2) at the final simulation time. This may correspond to an internal variable such as accumulated plastic strain or backstress.}}{19}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {20}{\ignorespaces SDV3: Distribution of the third state-dependent variable (SDV3) at the final simulation time, indicating another relevant mechanical quantity tracked by the UMAT.}}{20}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {21}{\ignorespaces SDV4: Distribution of the fourth state-dependent variable (SDV4) at the final simulation time, showing the spatial variation and localization effects.}}{20}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {22}{\ignorespaces SDV5: Distribution of the fifth state-dependent variable (SDV5) at the final simulation time, highlighting regions of maximum and minimum values.}}{21}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {23}{\ignorespaces SDV6: Distribution of the sixth state-dependent variable (SDV6) at the final simulation time, illustrating the evolution of the corresponding mechanical response.}}{21}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {24}{\ignorespaces SDV7: Distribution of the seventh state-dependent variable (SDV7) at the final simulation time, with maximum and minimum locations marked.}}{22}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {25}{\ignorespaces SDV8: Distribution of the eighth state-dependent variable (SDV8) at the final simulation time, showing the spatial variation across the plate.}}{22}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {26}{\ignorespaces SDV9: Distribution of the ninth state-dependent variable (SDV9) at the final simulation time, indicating the final state of the relevant mechanical quantity.}}{23}{}\protected@file@percent }
